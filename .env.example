# ─── Blockchain ───────────────────────────────────────────────────────────────
# Public RPC URL for Base Sepolia (exposed to browser via Next.js)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Alchemy API key for on-chain data in the agent runtime
ALCHEMY_API_KEY=

# Deployer private key — used by Hardhat deploy scripts and backend
PRIVATE_KEY=

# Server-side RPC URL for Hardhat and the agent runtime
BASE_SEPOLIA_RPC_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Privy App ID — get from privy.io dashboard
NEXT_PUBLIC_PRIVY_APP_ID=

# WalletConnect project ID — get from cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── AI ───────────────────────────────────────────────────────────────────────
# OpenAI key for agent LLM calls via Vercel AI SDK
OPENAI_API_KEY=

# ─── EAS ──────────────────────────────────────────────────────────────────────
# EAS contract address on Base Sepolia (canonical, do not change)
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021

# Schema UID registered on EAS for ChainMind attestation schema
SCHEMA_UID=

# ─── Infrastructure ───────────────────────────────────────────────────────────
# BullMQ job queue — local Redis instance
REDIS_URL=redis://localhost:6379

# Postgres connection string for agent metadata / activity log
DATABASE_URL=

# ─── Coinbase AgentKit ────────────────────────────────────────────────────────
# CDP API key credentials — get from developer.coinbase.com
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
