# ═══════════════════════════════════════════════════════════════════
#  ChainMind — Environment Variables Reference
#  Copy this file to .env and fill in all required values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── Frontend Origin ──────────────────────────────────────────────
# Used by the agent runtime to restrict CORS. Must match exactly.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string for agent metadata / activity log
DATABASE_URL=postgresql://user:password@localhost:5432/chainmind

# ─── Encryption ───────────────────────────────────────────────────
# AES-256-GCM key for encrypting CDP wallet material at rest.
# Must be exactly 64 lowercase hex characters (= 32 raw bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Blockchain ───────────────────────────────────────────────────
# Deployer private key — used by Hardhat deploy scripts and the agent runtime
# to sign on-chain transactions. Never expose publicly.
PRIVATE_KEY=

# Server-side RPC URL for Hardhat and the agent runtime (Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Public RPC URL for Base Sepolia (exposed to browser via Next.js)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Alchemy API key for enhanced on-chain data
# Get from: https://dashboard.alchemy.com
ALCHEMY_API_KEY=

# ─── Auth — Privy ─────────────────────────────────────────────────
# Get both values from: https://dashboard.privy.io → Settings → API Keys
# App ID is public (safe for browser); App Secret is server-side only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# WalletConnect project ID — get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── AI ───────────────────────────────────────────────────────────
# OpenAI API key for LLM calls in the agent worker
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Coinbase AgentKit ────────────────────────────────────────────
# CDP API credentials — get from https://developer.coinbase.com
# ⚠️  These variable names must match exactly — do NOT use CDP_API_KEY_NAME
#     or CDP_API_KEY_PRIVATE_KEY (those are the old v1 names).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# CDP wallet encryption secret (optional — leave blank to disable wallet encryption at CDP layer)
CDP_WALLET_SECRET=

# ─── EAS (Ethereum Attestation Service) ───────────────────────────
# EAS core contract address on Base Sepolia (canonical, do not change)
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021

# Schema UID registered on EAS for ChainMind attestations
SCHEMA_UID=

# Optional override for EAS GraphQL API (default: Base Sepolia testnet)
# EAS_GRAPHQL_URL=https://base-sepolia.easscan.org/graphql

# ─── Smart Contracts ──────────────────────────────────────────────
# Deployed contract addresses — populated after running:
#   pnpm --filter @chainmind/contracts deploy
# Leave blank to run in stub mode (no on-chain attestations).
CHAINMIND_ATTESTER_ADDRESS=
AGENT_REGISTRY_ADDRESS=

# ─── Infrastructure ───────────────────────────────────────────────
# BullMQ job queue Redis connection string
REDIS_URL=redis://localhost:6379

# HTTP port for the agent runtime Express server (default: 3001)
PORT=3001
