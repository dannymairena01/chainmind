generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id            String   @id @default(uuid())
  ownerId       String
  name          String
  taskType      String
  description   String?
  status        String   @default("idle")
  lastAction    String?
  walletAddress String?
  cdpWalletData    String?  @db.Text
  pendingJobId       String?
  pendingRationale String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
